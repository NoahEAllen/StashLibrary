# Secrets & local runtime (never commit)
.env
.env.local
*.local

# Media files
*.mp4
*.mkv
*.avi
*.wmv
*.mov
*.m4v
*.ts
*.m2ts
*.webm
*.part
*.rar
*.zip
!docs/**/*.zip

# Runtime data dirs
metadata/**
!metadata/.gitkeep
cache/**
!cache/.gitkeep
blobs/**
!blobs/.gitkeep
generated/**
!generated/.gitkeep

# Library media (keep structure only)
library/**/*
!library/**/
!library/**/.gitkeep

# App config & installed providers (generated on target machine)
config/*.yml
config/*.yaml
config/*.sqlite*
config/*.sqlite
config/config.yml
config/providers/**
!config/providers/.gitkeep
!config/README.md
config/providers/_skip-log.txt
config/providers/_install-log.txt

# Install logs (legacy scripts/ path + providers path)
_MANIFEST.txt
scripts/_install-log.txt
scripts/_skip-log.txt
presets/libraries.json

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*~

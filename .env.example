# Copy to .env (gitignored). scripts/start.ps1 or start.sh fills remaining keys on first run.
# Do not put image names or upstream path keys here in plaintext — start writes them.
MV_HOST_PORT=9999
# Optional GraphQL endpoint for auto-scan (default: http://localhost:${MV_HOST_PORT}/graphql)
# MV_GRAPHQL_URL=http://localhost:9999/graphql
# API Key from Web UI → Settings → Security (required by auto-scan / watch-inbox)
# MV_API_KEY=
# Host media roots for docker-compose bind mounts (this machine). Paths use forward slashes.
# MV_MEDIA_TEMP=E:/TEMP
# MV_MEDIA_CLOUD=E:/迅雷云盘
# MV_MEDIA_DL=E:/迅雷下载

# watch-media: poll seconds; set 1/true to also watch library/_inbox
# MV_WATCH_INTERVAL=60
# MV_WATCH_INCLUDE_INBOX=0

# --- Optional discovery sidecars (copy compose *.yml.example first; do not commit secrets) ---
# WHISPARR_HOST_PORT=6969
# WHISPARR_CONFIG=./runtime/whisparr-config
# AI_SERVER_HOST_PORT=4153
# AI_SERVER_DB_PORT=5432
# AI_SERVER_DB_NAME=stash_ai_server
# AI_SERVER_DB_USER=stash_ai_server
# AI_SERVER_DB_PASSWORD=
# STASH_SENSE_HOST_PORT=6960
# STASH_SENSE_DATA=./runtime/stash-sense-data
# STASH_URL=http://host.docker.internal:9999
# STASH_API_KEY=   # same as MV_API_KEY when pointing sidecars at this MediaVault
